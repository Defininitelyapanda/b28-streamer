{
  "name": "b28-oncodex",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm install --prefix frontend && npm install --prefix backend && npm install --prefix backend/dashboard",
    "start": "powershell -ExecutionPolicy Bypass -File scripts/dev-up.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "doctor": "powershell -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-dev.ps1",
    "dev": "npm run dev --prefix frontend",
    "dev:api": "npm run start:dev --prefix backend",
    "dev:dashboard": "npm run dev --prefix backend/dashboard",
    "dev:all": "concurrently -n frontend,api,dashboard,wait -c blue,green,magenta,cyan --kill-others-on-fail \"npm run dev --prefix frontend\" \"npm run start:dev --prefix backend\" \"npm run dev --prefix backend/dashboard\" \"node scripts/wait-for-dev.js\"",
    "build": "npm run build --prefix frontend",
    "build:dashboard": "npm run build --prefix backend/dashboard",
    "db:up": "powershell -ExecutionPolicy Bypass -File scripts/setup-db.ps1",
    "db:up:docker": "powershell -ExecutionPolicy Bypass -File scripts/docker-up.ps1",
    "wsl:install": "powershell -ExecutionPolicy Bypass -File scripts/install-wsl.ps1",
    "db:migrate": "npm run prisma:migrate:deploy --prefix backend",
    "db:seed": "npm run prisma:seed --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
