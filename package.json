{
  "name": "b28-oncodex",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:api": "npm run start:dev --prefix backend",
    "dev:dashboard": "npm run dev --prefix backend/dashboard",
    "dev:all": "npx concurrently \"npm run dev --prefix frontend\" \"npm run start:dev --prefix backend\" \"npm run dev --prefix backend/dashboard\"",
    "build": "npm run build --prefix frontend",
    "build:dashboard": "npm run build --prefix backend/dashboard",
    "db:up": "powershell -ExecutionPolicy Bypass -File scripts/setup-db.ps1",
    "db:up:docker": "powershell -ExecutionPolicy Bypass -File scripts/docker-up.ps1",
    "wsl:install": "powershell -ExecutionPolicy Bypass -File scripts/install-wsl.ps1",
    "db:migrate": "npm run prisma:migrate:deploy --prefix backend",
    "db:seed": "npm run prisma:seed --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
