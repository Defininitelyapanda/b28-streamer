# Frontend environment (copy to frontend/.env.local)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
CRON_SECRET=

# NextAuth (Auth.js v5)
AUTH_SECRET=change-me-auth-secret-min-32-chars
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_SECRET=

# Backend API — streaming site loads catalog from here when available
# Local dev:
B28_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Vercel production (same domain, set in Vercel dashboard):
# NEXT_PUBLIC_API_URL=/api/v1
# AUTH_URL=https://YOUR-APP.vercel.app
# B28_API_URL is injected via vercel.json service binding — do not set manually on Vercel
CATALOG_REVALIDATE_SECONDS=30

# Optional: Google Sign-In client ID (Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Dev only — bypass subscription checks locally (never enable in production)
NEXT_PUBLIC_DEV_BYPASS_STREAMING=true
