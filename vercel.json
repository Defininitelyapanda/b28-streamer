{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "B28_API_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "nestjs",
      "installCommand": "npm install --include=dev && npx prisma generate",
      "buildCommand": "node scripts/vercel-bundle.js && node scripts/vercel-postbuild.js"
    }
  },
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/api/docs/:path*",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/health/:path*",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
