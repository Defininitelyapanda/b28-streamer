FROM node:20-bookworm-slim AS build
WORKDIR /opt/backend

RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
RUN npm ci --include=dev

COPY prisma ./prisma
RUN npx prisma generate

COPY . .
RUN npm run build

FROM node:20-bookworm-slim AS dependencies
WORKDIR /opt/backend
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

FROM node:20-bookworm-slim
WORKDIR /opt/backend

RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV VERCEL=1
ENV PORT=80

COPY --from=dependencies /opt/backend/node_modules ./node_modules
COPY --from=build /opt/backend/dist ./dist
COPY --from=build /opt/backend/prisma ./prisma
COPY --from=build /opt/backend/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /opt/backend/node_modules/@prisma ./node_modules/@prisma
COPY package.json package-lock.json* ./

COPY docker-start.js /usr/local/bin/docker-start.js
RUN cp dist/src/main.js dist/src/main.cjs \
  && node -e "JSON.parse(require('fs').readFileSync('package.json','utf8'))" \
  && chown -R node:node /opt/backend \
  && chown node:node /usr/local/bin/docker-start.js

USER node
CMD ["/usr/local/bin/node", "/usr/local/bin/docker-start.js"]
