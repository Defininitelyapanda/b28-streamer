generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleName {
  STREAMER
  FILMMAKER
  MODERATOR
  FINANCE_ADMIN
  CONTENT_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionPlan {
  FREE_WITH_ADS
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentMethodType {
  MPESA
  PAYPAL
  CARD
}

enum FilmmakerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  phone           String?    @unique
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  suspendedAt     DateTime?  @map("suspended_at")
  deletedAt       DateTime?  @map("deleted_at")
  failedLoginAttempts Int    @default(0) @map("failed_login_attempts")
  lockedUntil     DateTime?  @map("locked_until")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  profile               UserProfile?
  roles                 UserRole[]
  refreshTokens         RefreshToken[]
  sessions              UserSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  otpChallenges         OtpChallenge[]
  auditLogs             AuditLog[] @relation("AuditActor")
  settingsUpdated       PlatformSetting[] @relation("SettingUpdater")
  subscription          UserSubscription?
  paymentMethods        PaymentMethod[]
  watchProgress         WatchProgress[]
  watchlist             WatchlistItem[]
  oauthAccounts         OAuthAccount[]
  filmmakerApplication  FilmmakerApplication?

  @@index([status])
  @@map("users")
}

model UserProfile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")
  country     String?
  timezone    String? @default("UTC")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  refreshTokenId String? @unique @map("refresh_token_id") @db.Uuid
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model OtpChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  phone     String
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@map("otp_challenges")
}

model PlatformSetting {
  key       String   @id
  value     Json
  type      String
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  updater User? @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([resource, resourceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum VideoAccessTier {
  FREE
  PREMIUM
}

enum PlaybackFormat {
  YOUTUBE
  MP4
  HLS
}

model CatalogVideo {
  slug            String           @id
  title           String
  thumbnail       String
  date            String
  genre           String
  description     String           @map("description")
  rating          String
  sourceType      String           @map("source_type")
  videoId         String           @map("video_id")
  type            String
  seriesGroup     String           @map("series_group")
  accessTier      VideoAccessTier  @default(FREE) @map("access_tier")
  playbackFormat  PlaybackFormat   @default(YOUTUBE) @map("playback_format")
  storageKey      String?          @map("storage_key")
  durationSeconds Int?             @map("duration_seconds")
  posterUrl       String?          @map("poster_url")
  published       Boolean          @default(true)
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([published])
  @@index([genre])
  @@index([published, genre, sortOrder])
  @@index([accessTier])
  @@map("catalog_videos")
}

model UserSubscription {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @unique @map("user_id") @db.Uuid
  plan       SubscriptionPlan   @default(FREE_WITH_ADS)
  status     SubscriptionStatus @default(ACTIVE)
  adsEnabled Boolean            @default(true) @map("ads_enabled")
  expiresAt  DateTime?          @map("expires_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

model PaymentMethod {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  type      PaymentMethodType
  label     String
  last4     String?           @map("last4")
  isDefault Boolean           @default(false) @map("is_default")
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_methods")
}

model WatchProgress {
  userId          String   @map("user_id") @db.Uuid
  videoSlug       String   @map("video_slug")
  progressSeconds Int      @default(0) @map("progress_seconds")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, videoSlug])
  @@index([userId, updatedAt])
  @@map("watch_progress")
}

model WatchlistItem {
  userId    String   @map("user_id") @db.Uuid
  videoSlug String   @map("video_slug")
  addedAt   DateTime @default(now()) @map("added_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, videoSlug])
  @@index([userId, addedAt])
  @@map("watchlist_items")
}

model OAuthAccount {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String
  providerId String   @map("provider_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model FilmmakerApplication {
  id         String                     @id @default(uuid()) @db.Uuid
  userId     String                     @unique @map("user_id") @db.Uuid
  status     FilmmakerApplicationStatus @default(PENDING)
  message    String?
  reviewedAt DateTime?                  @map("reviewed_at")
  createdAt  DateTime                   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("filmmaker_applications")
}
