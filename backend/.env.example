DATABASE_URL=postgresql://b28:b28@localhost:5434/b28_oncodex
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
API_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
NODE_ENV=development
SWAGGER_ENABLED=true

# Auto-verify emails on register (true in dev by default; set true on Vercel until email provider is configured)
AUTH_AUTO_VERIFY=false

# Google OAuth — server-side ID token verification
GOOGLE_CLIENT_ID=

# YouTube catalog sync → Postgres
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
CRON_SECRET=

# Cloudflare R2 (self-hosted MP4/HLS playback)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Email (optional — uses console logger when unset)
RESEND_API_KEY=
EMAIL_FROM=B28 Oncodex <noreply@b28.dev>

# For Neon/Vercel Postgres with pooling, use ?pgbouncer=true on DATABASE_URL

# Dev only — bypass subscription checks locally (never enable in production; startup will refuse)
DEV_BYPASS_STREAMING=false

# Dev only — enable PREMIUM/payment feature flags when seeding (default off for Phase A safety)
# SEED_ENABLE_PAYMENT_FLAGS=true
