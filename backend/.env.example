DATABASE_URL=postgresql://b28:b28@localhost:5434/b28_oncodex
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
API_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
NODE_ENV=development
SWAGGER_ENABLED=true

# Auto-verify emails on register (true in dev by default; set true on Vercel until email provider is configured)
AUTH_AUTO_VERIFY=false

# Google OAuth — server-side ID token verification
GOOGLE_CLIENT_ID=

# Email (optional — uses console logger when unset)
RESEND_API_KEY=
EMAIL_FROM=B28 Oncodex <noreply@b28.dev>

# For Neon/Vercel Postgres with pooling, use ?pgbouncer=true on DATABASE_URL
